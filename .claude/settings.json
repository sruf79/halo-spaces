{
  "permissions": {
    "allow": [
      "ListAgents",
      "SendMessage",
      "mcp__claude-code-remote__list_sessions",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__confirm_repository_trust"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "35"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tests/neon-hook.sh\""
          }
        ]
      }
    ]
  }
}
