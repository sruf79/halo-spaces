{
  "manifest_version": 2,
  "name": "halo.spaces",
  "description": "A calm, tidy macOS-style design for Thunderbird – with colourful spaces, sender pictures, message previews and a unified address book.",
  "version": "3.11.0",
  "author": "halo.spaces",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-cards@sebastian.local",
      "strict_min_version": "153.0",
      "update_url": "https://raw.githubusercontent.com/sruf79/halo-spaces/main/updates.json"
    }
  },
  "background": {
    "page": "background.html"
  },
  "experiment_apis": {
    "mailCards": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "mailCards"
          ]
        ],
        "script": "api/implementation.js",
        "events": [
          "startup"
        ]
      }
    }
  },
  "homepage_url": "https://github.com/sruf79/halo-spaces",
  "icons": {
    "64": "about/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
